# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# NextAuth Configuration
NEXTAUTH_SECRET="your-nextauth-secret-key"

# Database Configuration (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Google SMTP Configuration
# Replace SMTP_USER with your Gmail address
# Replace SMTP_PASS with your 16-character Google App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM_NAME="CommandDesk"
SMTP_FROM_EMAIL="your-email@gmail.com"

# Self URL & Keep-Alive Configuration (Prevents server from going inactive/sleeping)
# Set this to your deployed domain in production (e.g. https://your-app.onrender.com or https://commanddesk-gold.vercel.app)
SELF_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
ENABLE_KEEP_ALIVE="true"
KEEP_ALIVE_INTERVAL_MINUTES="10"
NODE_OPTIONS="--max-http-header-size=1048576"
